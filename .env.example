# Copie para .env e preencha. O .env nunca vai para o repositório (PRD 10, Segredos).

# Conexão com o PostgreSQL, usando o usuário próprio da aplicação (sem superusuário)
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/patotinha

# Banco separado só para os testes automáticos (é apagado e recriado pelos testes)
DATABASE_URL_TESTE=postgresql://USUARIO:SENHA@localhost:5432/patotinha_teste

# Segredo do token de sessão: texto longo e aleatório (por exemplo, 64 caracteres)
JWT_SECRET=

# development | production | test
NODE_ENV=development

# Endereço pelo qual o sistema é acessado (usado em produção e no CORS, se houver)
APP_ORIGIN=http://localhost:5173

# Fuso horário do servidor
TZ=America/Sao_Paulo

# Porta da API (opcional, padrão 3000)
PORT=3000
