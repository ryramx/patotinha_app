// Modelo de dados do MVP (PRD seções 6 e 15): seis tabelas, mais as de perfis de acesso e clientes.
// Comanda digital (nome do cliente e fila de preparo) na migração 20261016000000_comanda.
// Perfis e permissões (etapa 10) na migração 20261017000000_perfis.
// Clientes (sugestão de nome no novo pedido, telefone opcional) na migração 20261017010000_clientes.
// CHECKs, índices em lower() e o gatilho de atualizado_em ficam na migração SQL,
// porque o Prisma não os representa no schema.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           BigInt   @id @default(autoincrement())
  nome         String   @db.VarChar(100)
  login        String   @db.VarChar(50)
  senhaHash    String   @map("senha_hash") @db.VarChar(255)
  perfil       String   @db.VarChar(20)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  dadosPerfil       Perfil   @relation(fields: [perfil], references: [codigo], onDelete: Restrict, onUpdate: NoAction, map: "fk_usuarios_perfil")
  pedidos           Pedido[] @relation("PedidoUsuario")
  pedidosCancelados Pedido[] @relation("PedidoCanceladoPor")

  @@index([perfil], map: "ix_usuarios_perfil")
  @@map("usuarios")
}

model Perfil {
  codigo       String   @id @db.VarChar(20)
  nome         String   @db.VarChar(40)
  permissoes   String[] @default([]) @db.VarChar(30)
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  usuarios Usuario[]

  @@map("perfis")
}

model Categoria {
  id           BigInt   @id @default(autoincrement())
  nome         String   @db.VarChar(60)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id           BigInt   @id @default(autoincrement())
  categoriaId  BigInt   @map("categoria_id")
  nome         String   @db.VarChar(100)
  preco        Decimal  @db.Decimal(10, 2)
  ingredientes String?  @db.VarChar(300)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  categoria Categoria    @relation(fields: [categoriaId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  itens     ItemPedido[]

  @@index([categoriaId], map: "ix_produtos_categoria")
  @@map("produtos")
}

model FormaPagamento {
  id     Int     @id @db.SmallInt
  codigo String  @unique @db.VarChar(20)
  nome   String  @db.VarChar(40)
  ativo  Boolean @default(true)

  pedidos Pedido[]

  @@map("formas_pagamento")
}

model Pedido {
  id                 BigInt    @id @default(autoincrement())
  status             String    @db.VarChar(20)
  usuarioId          BigInt    @map("usuario_id")
  formaPagamentoId   Int?      @map("forma_pagamento_id") @db.SmallInt
  total              Decimal   @default(0) @db.Decimal(10, 2)
  valorRecebido      Decimal?  @map("valor_recebido") @db.Decimal(10, 2)
  troco              Decimal?  @db.Decimal(10, 2)
  chaveIdempotencia  String?   @unique @map("chave_idempotencia") @db.Uuid
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  finalizadoEm       DateTime? @map("finalizado_em") @db.Timestamptz(6)
  canceladoEm        DateTime? @map("cancelado_em") @db.Timestamptz(6)
  canceladoPorId     BigInt?   @map("cancelado_por_id")
  motivoCancelamento String?   @map("motivo_cancelamento") @db.VarChar(255)
  clienteNome        String?   @map("cliente_nome") @db.VarChar(60)
  clienteId          BigInt?   @map("cliente_id")
  statusPreparo      String    @default("AGUARDANDO") @map("status_preparo") @db.VarChar(20)
  preparoAtualizadoEm DateTime? @map("preparo_atualizado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime  @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  usuario        Usuario         @relation("PedidoUsuario", fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  canceladoPor   Usuario?        @relation("PedidoCanceladoPor", fields: [canceladoPorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  cliente        Cliente?        @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  itens          ItemPedido[]

  @@index([criadoEm(sort: Desc)], map: "ix_pedidos_criado_em")
  @@index([status, criadoEm], map: "ix_pedidos_status_criado")
  @@index([usuarioId], map: "ix_pedidos_usuario")
  @@index([formaPagamentoId], map: "ix_pedidos_forma_pgto")
  @@index([clienteId], map: "ix_pedidos_cliente")
  @@map("pedidos")
}

// Quem já pediu no balcão. "chave" é o nome sem acentos, maiúsculas nem espaços sobrando.
model Cliente {
  id             BigInt   @id @default(autoincrement())
  nome           String   @db.VarChar(60)
  chave          String   @unique @db.VarChar(60)
  telefone       String?  @db.VarChar(11)
  ultimoPedidoEm DateTime @default(now()) @map("ultimo_pedido_em") @db.Timestamptz(6)
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  pedidos Pedido[]

  @@map("clientes")
}

model ItemPedido {
  id            BigInt  @id @default(autoincrement())
  pedidoId      BigInt  @map("pedido_id")
  produtoId     BigInt  @map("produto_id")
  nomeProduto   String  @map("nome_produto") @db.VarChar(100)
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([pedidoId, produtoId], map: "uq_itens_pedido_produto")
  @@index([produtoId], map: "ix_itens_produto")
  @@map("itens_pedido")
}
